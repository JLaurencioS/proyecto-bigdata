NODE_ENV=development
PORT=3000

# --- Connection string de MongoDB ---
# Opción A: Mongo local SIN autenticación (instalación por defecto en Windows)
MONGO_URI=mongodb://127.0.0.1:27017
# Opción B: Mongo local CON autenticación
# MONGO_URI=mongodb://usuario:clave@127.0.0.1:27017/?authSource=admin
# Opción C: MongoDB Atlas
# MONGO_URI=mongodb+srv://usuario:clave@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

MONGO_DB=fleet

SESSION_SECRET=reemplaza_por_un_valor_largo_y_aleatorio
SESSION_TTL_HOURS=8

# Usuarios semilla (paso 3)
SEED_DISPATCHER_PASSWORD=cambia_esto_1
SEED_ANALYST_PASSWORD=cambia_esto_2

# Poner true SOLO si sirves la app por HTTPS (con HTTP la cookie nunca se guardaría)
COOKIE_SECURE=false
# true solo si estás detrás de un proxy/balanceador (Nginx, ALB)
TRUST_PROXY=false
# Valida también las respuestas contra openapi.yml (útil en desarrollo)
VALIDATE_RESPONSES=true